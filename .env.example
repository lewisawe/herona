# Live EVM testnet settlement (optional).
# When BOTH are set, the cross-chain settlement leg deploys the settler and
# submits settle() as real transactions on a public EVM testnet (default Sepolia),
# viewable on Etherscan. When unset, the app uses the offline in-process EVM.
#
# Copy this file to `.env` (which is gitignored) and fill in your values.
# NEVER commit a real private key.

# A Sepolia RPC endpoint (Alchemy/Infura/public). Example:
#   https://sepolia.infura.io/v3/<PROJECT_ID>
#   https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
#   https://rpc.sepolia.org            (public, flakier)
EVM_RPC_URL=

# A funded Sepolia private key (0x-prefixed). Gets Sepolia ETH from a faucet.
EVM_DEPLOYER_KEY=

# Optional labels (defaults shown)
# EVM_NETWORK_LABEL=Sepolia
# EVM_EXPLORER_BASE=https://sepolia.etherscan.io
